<div class="govtech-tile-container" style="background:#111827;border:1px solid #1f2937;border-radius:12px;padding:20px;box-shadow:0 10px 25px rgba(0,0,0,0.3);">
  <div style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #374151;padding-bottom:12px;margin-bottom:16px;">
    <h3 style="margin:0;font-size:1.2rem;color:#38bdf8;">🏛️ GovTech Client Operations Tile</h3>
    <span style="background:#1e3a8a;color:#93c5fd;padding:3px 10px;border-radius:9999px;font-size:11px;font-weight:700;">BUSINESS 1 ACTIVE</span>
  </div>

  <div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:12px;margin-bottom:20px;text-align:center;">
    <div style="background:#1f2937;padding:12px;border-radius:8px;">
      <div style="font-size:22px;font-weight:800;color:#f8fafc;"><%= summary.total_clients %></div>
      <div style="font-size:11px;color:#94a3b8;text-transform:uppercase;">Total Clients</div>
    </div>
    <div style="background:#1f2937;padding:12px;border-radius:8px;">
      <div style="font-size:22px;font-weight:800;color:#34d399;"><%= summary.active_payments %></div>
      <div style="font-size:11px;color:#94a3b8;text-transform:uppercase;">Active Paid</div>
    </div>
    <div style="background:#1f2937;padding:12px;border-radius:8px;">
      <div style="font-size:22px;font-weight:800;color:#38bdf8;"><%= summary.avg_readiness %>%</div>
      <div style="font-size:11px;color:#94a3b8;text-transform:uppercase;">Avg Readiness</div>
    </div>
    <div style="background:#1f2937;padding:12px;border-radius:8px;">
      <div style="font-size:22px;font-weight:800;color:#fbbf24;"><%= summary.total_proposals %></div>
      <div style="font-size:11px;color:#94a3b8;text-transform:uppercase;">Proposals Tracked</div>
    </div>
  </div>

  <table style="width:100%;border-collapse:collapse;font-size:13px;text-align:left;">
    <thead>
      <tr style="border-bottom:2px solid #374151;color:#94a3b8;">
        <th style="padding:8px;">Client Entity</th>
        <th style="padding:8px;">Plan / Product</th>
        <th style="padding:8px;">Payment Status</th>
        <th style="padding:8px;">Readiness Score</th>
        <th style="padding:8px;">Proposals</th>
        <th style="padding:8px;">Next Action</th>
      </tr>
    </thead>
    <tbody>
      <% if (clients && clients.length) { %>
        <% clients.forEach(function(c) { %>
          <tr style="border-bottom:1px solid #1f2937;">
            <td style="padding:10px 8px;font-weight:600;color:#f1f5f9;"><%= c.business_name %><br><small style="color:#64748b;"><%= c.client_id %></small></td>
            <td style="padding:10px 8px;"><%= c.preferred_plan || c.selected_plan || 'Readiness' %></td>
            <td style="padding:10px 8px;">
              <span style="padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700;<%= c.onboarding_status === 'active' ? 'background:#065f46;color:#6ee7b7;' : 'background:#78350f;color:#fde68a;' %>">
                <%= c.onboarding_status || 'pending_payment' %>
              </span>
            </td>
            <td style="padding:10px 8px;color:#38bdf8;font-weight:700;"><%= c.readiness_score || 85 %>/100</td>
            <td style="padding:10px 8px;"><%= c.proposal_count || 0 %></td>
            <td style="padding:10px 8px;color:#94a3b8;"><%= c.next_action || 'Review SAM Registration' %></td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr><td colspan="6" style="padding:20px;text-align:center;color:#64748b;">No GovTech clients registered yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
