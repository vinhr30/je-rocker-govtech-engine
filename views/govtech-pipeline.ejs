<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/src/styles/dashboard.css">
  <style>
    body {
      margin: 0;
      padding: 0;
      background: #0b0f17;
      color: #e2e8f0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .pipeline-container {
      max-width: 1380px;
      margin: 0 auto;
      padding: 30px 20px;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      border-bottom: 1px solid #1e293b;
      padding-bottom: 16px;
    }
    .header h1 {
      margin: 0;
      font-size: 26px;
      color: #38bdf8;
    }
    .metrics-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 30px;
    }
    .metric-card {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 10px;
      padding: 20px;
      text-align: center;
    }
    .metric-val {
      font-size: 28px;
      font-weight: 800;
      color: #34d399;
      margin-bottom: 4px;
    }
    .metric-label {
      font-size: 12px;
      text-transform: uppercase;
      color: #94a3b8;
      font-weight: 600;
      letter-spacing: 0.05em;
    }
    .section-box {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 10px;
      padding: 24px;
      margin-bottom: 30px;
    }
    .section-title {
      font-size: 18px;
      color: #f1f5f9;
      margin: 0 0 16px;
      border-bottom: 1px solid #1e293b;
      padding-bottom: 8px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    th, td {
      padding: 10px 12px;
      text-align: left;
      border-bottom: 1px solid #1e293b;
    }
    th {
      color: #94a3b8;
      font-weight: 700;
      text-transform: uppercase;
      font-size: 11px;
    }
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 700;
    }
    .badge-stage {
      background: #1e3a8a;
      color: #93c5fd;
    }
    .nav-btn {
      padding: 8px 16px;
      background: #1e293b;
      border: 1px solid #334155;
      color: #f8fafc;
      text-decoration: none;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      margin-left: 8px;
    }
    .nav-btn:hover {
      background: #0284c7;
      border-color: #0284c7;
    }
  </style>
</head>
<body>
  <div class="pipeline-container">
    <div class="header">
      <div>
        <span style="background:#1e3a8a;color:#93c5fd;padding:3px 10px;border-radius:9999px;font-size:11px;font-weight:700;">BUSINESS 1 CRM</span>
        <h1 style="margin-top:6px;">GovTech Commercial Pipeline &amp; Revenue Ledger</h1>
      </div>
      <div>
        <a href="/cover" class="nav-btn">&larr; GovTech Cover</a>
        <a href="/govtech-dashboard" class="nav-btn">Operations Dashboard</a>
        <a href="/govtech-intake" class="nav-btn">+ Client Intake</a>
        <a href="/business-driver" class="nav-btn">Business Driver</a>
      </div>
    </div>

    <div class="metrics-row">
      <div class="metric-card">
        <div class="metric-val">$<%= pipeline.financial_summary.mrr.toLocaleString('en-US', { minimumFractionDigits: 2 }) %></div>
        <div class="metric-label">Monthly Recurring Revenue (MRR)</div>
      </div>
      <div class="metric-card">
        <div class="metric-val">$<%= pipeline.financial_summary.total_revenue.toLocaleString('en-US', { minimumFractionDigits: 2 }) %></div>
        <div class="metric-label">Cumulative GovTech Revenue</div>
      </div>
      <div class="metric-card">
        <div class="metric-val">$<%= (pipeline.financial_summary.active_contracts_value / 1000000).toFixed(2) %>M</div>
        <div class="metric-label">Active Pursuits Value</div>
      </div>
      <div class="metric-card">
        <div class="metric-val" style="color:#38bdf8;"><%= pipeline.proposal_metrics.win_rate %></div>
        <div class="metric-label">Win Rate (<%= pipeline.proposal_metrics.won %>/<%= pipeline.proposal_metrics.submitted %> Won)</div>
      </div>
    </div>

    <div class="section-box">
      <h2 class="section-title">Active Retained &amp; Subscription Clients</h2>
      <table>
        <thead>
          <tr>
            <th>Client Identifier</th>
            <th>Company Name</th>
            <th>Plan Enrolled</th>
            <th>Monthly Retainer / Fee</th>
            <th>Proposals Won</th>
            <th>Account Status</th>
          </tr>
        </thead>
        <tbody>
          <% pipeline.active_clients.forEach(function(c) { %>
            <tr>
              <td><code><%= c.client_id %></code></td>
              <td style="font-weight:600;color:#f8fafc;"><%= c.company_name %></td>
              <td><%= c.plan %></td>
              <td style="color:#34d399;font-weight:700;">$<%= c.monthly_fee.toFixed(2) %></td>
              <td><%= c.proposals_won %> Won / <%= c.proposals_lost %> Lost</td>
              <td><span class="badge" style="background:#065f46;color:#6ee7b7;"><%= c.status %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="section-box">
      <h2 class="section-title">Inbound Leads &amp; Target Pipeline Opportunities</h2>
      <table>
        <thead>
          <tr>
            <th>Lead ID</th>
            <th>Company Name</th>
            <th>Contact Person</th>
            <th>Target Plan</th>
            <th>Deal Value</th>
            <th>Probability</th>
            <th>Pipeline Stage</th>
          </tr>
        </thead>
        <tbody>
          <% pipeline.leads.forEach(function(l) { %>
            <tr>
              <td><code><%= l.lead_id %></code></td>
              <td style="font-weight:600;color:#f8fafc;"><%= l.company_name %></td>
              <td><%= l.contact_name %><br><small style="color:#64748b;"><%= l.email %></small></td>
              <td><%= l.target_plan %></td>
              <td style="color:#34d399;font-weight:700;">$<%= l.potential_deal_size.toFixed(2) %></td>
              <td style="color:#38bdf8;"><%= l.probability %></td>
              <td><span class="badge badge-stage"><%= l.stage %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
